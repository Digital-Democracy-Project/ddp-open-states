#!/bin/bash
# os-status — status of active OpenStates scrapers and bill archivers.
#
# Invoked as `os status` (see the os() function in ~/.zshrc). Read-only:
# inspects ps, logs/scraper.log in the production checkout, and file mtimes
# on DDP-HOT. Estimates are rough by design and labeled as such:
#   - archiver backlog comes from the last completed run's own summary line
#     (fetched + fetch_errors), minus files landed this run
#   - throughput comes from files created on DDP-HOT in the last 15 minutes
#   - scraper ETA is just "how long the previous completed run took"

LOG=/Users/agentsmith/Developer/repos/ddp-open-states/logs/scraper.log
RAW=/Volumes/DDP-HOT/Bills/raw

now_human=$(date '+%Y-%m-%d %H:%M:%S %Z')
found_any=0

humanize_min() {  # minutes -> "Xh Ym" / "Ym"
    local m=$1
    if [ "$m" -ge 60 ]; then echo "$((m / 60))h $((m % 60))m"; else echo "${m}m"; fi
}

# Timestamp ("YYYY-MM-DD HH:MM:SS") of the last log line matching $1.
last_log_ts() {
    grep -E "^\[[0-9-]+ [0-9:]+\] $1" "$LOG" | tail -1 | sed -E 's/^\[([0-9-]+ [0-9:]+)\].*/\1/'
}

# Duration (minutes) of the last COMPLETED run for a jurisdiction, from the
# wrapper's own bracketed log lines. $1=start-pattern $2=end-pattern
# (BSD awk has no mktime, so pair the lines by line number and diff with date.)
prev_run_minutes() {
    local end_line end_ln start_line s e se ee
    end_line=$(grep -nE "^\[[0-9-]+ [0-9:]+\] $2" "$LOG" | tail -1)
    [ -z "$end_line" ] && return
    end_ln=${end_line%%:*}
    start_line=$(head -n "$end_ln" "$LOG" | grep -nE "^\[[0-9-]+ [0-9:]+\] $1" | tail -1)
    [ -z "$start_line" ] && return
    s=$(echo "$start_line" | sed -E 's/^[0-9]+:\[([0-9-]+ [0-9:]+)\].*/\1/')
    e=$(echo "$end_line" | sed -E 's/^[0-9]+:\[([0-9-]+ [0-9:]+)\].*/\1/')
    se=$(date -j -f '%Y-%m-%d %H:%M:%S' "$s" +%s 2>/dev/null)
    ee=$(date -j -f '%Y-%m-%d %H:%M:%S' "$e" +%s 2>/dev/null)
    [ -n "$se" ] && [ -n "$ee" ] && echo $(((ee - se) / 60))
}

print_job() {  # $1=kind $2=jurisdiction $3=pid
    local kind=$1 juris=$2 pid=$3
    found_any=1
    local etime lstart start_fmt ppid orphan=""
    etime=$(ps -o etime= -p "$pid" | tr -d ' ')
    lstart=$(ps -o lstart= -p "$pid")
    ppid=$(ps -o ppid= -p "$pid" | tr -d ' ')
    [ "$ppid" = "1" ] && orphan="  (ORPHANED — parent gone; completion will not be logged/alerted)"
    start_fmt=$(date -j -f "%a %b %e %T %Y" "$lstart" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)

    printf '%-9s %-4s pid %-6s running %s (since %s)%s\n' \
        "$kind" "$juris" "$pid" "$etime" "${start_fmt:-?}" "$orphan"

    if [ "$kind" = "ARCHIVER" ] && [ -d "$RAW/$juris" ] && [ -n "$start_fmt" ]; then
        local done rate15 cutoff rate_disp="stalled?"
        done=$(find "$RAW/$juris" -type f ! -name '.DS_Store' -newermt "$start_fmt" 2>/dev/null | wc -l | tr -d ' ')
        cutoff=$(date -v-15M '+%Y-%m-%d %H:%M:%S')
        rate15=$(find "$RAW/$juris" -type f ! -name '.DS_Store' -newermt "$cutoff" 2>/dev/null | wc -l | tr -d ' ')
        [ "$rate15" -gt 0 ] && rate_disp="~$((rate15 / 15)).$(((rate15 * 10 / 15) % 10))/min"
        printf '  archived this run: %s docs on DDP-HOT (last 15m: %s)\n' "$done" "$rate_disp"

        # Backlog ≈ last completed summary's fetched + fetch_errors, minus every
        # file landed SINCE that summary (which may span runs the summary doesn't
        # know about). fetch_errors includes permanently-dead URLs, so this is an
        # upper bound.
        local summary fetched errors backlog remaining summary_ts done_since
        summary=$(grep -E "^$juris: [0-9]+ bills checked" "$LOG" | tail -1)
        if [ -n "$summary" ]; then
            fetched=$(echo "$summary" | sed -E 's/.*fetched=([0-9]+).*/\1/')
            errors=$(echo "$summary" | sed -E 's/.*fetch_errors=([0-9]+).*/\1/')
            backlog=$((fetched + errors))
            summary_ts=$(last_log_ts "Archiving done: $juris")
            done_since=$done
            [ -n "$summary_ts" ] && done_since=$(find "$RAW/$juris" -type f ! -name '.DS_Store' -newermt "$summary_ts" 2>/dev/null | wc -l | tr -d ' ')
            remaining=$((backlog - done_since)); [ "$remaining" -lt 0 ] && remaining=0
            if [ "$rate15" -gt 0 ] && [ "$remaining" -gt 0 ]; then
                printf '  est. remaining:    ≤%s docs → ~%s at current rate (rough; backlog from last summary)\n' \
                    "$remaining" "$(humanize_min $((remaining * 15 / rate15)))"
            else
                printf '  est. remaining:    ≤%s docs (rough; backlog from last summary)\n' "$remaining"
            fi
        fi
        local prev
        prev=$(prev_run_minutes "Archiving bill documents: $juris" "Archiving done: $juris")
        [ -n "$prev" ] && printf '  previous run took: %s\n' "$(humanize_min "$prev")"
    fi

    if [ "$kind" = "SCRAPER" ]; then
        local last_summary prev
        last_summary=$(grep -E "=== SCRAPE SUMMARY: $juris " "$LOG" | tail -1 | sed -E 's/.*=== SCRAPE SUMMARY: //; s/ ===$//')
        [ -n "$last_summary" ] && printf '  last completed:    %s\n' "$last_summary"
        prev=$(prev_run_minutes "Scraping $juris" "Scrape done: $juris")
        [ -n "$prev" ] && printf '  previous run took: %s (rough ETA reference)\n' "$(humanize_min "$prev")"
    fi
    echo
}

echo "OpenStates jobs — $now_human"
echo

# Workers, not wrappers: os-update <state> --scrape (scraper),
# os-text-extract archive <abbr> (archiver).
while read -r pid juris; do
    print_job ARCHIVER "$juris" "$pid"
done < <(ps -axo pid=,command= | sed -nE 's|^ *([0-9]+) .*/os-text-extract archive ([a-z]{2,3}).*|\1 \2|p')

while read -r pid juris; do
    print_job SCRAPER "$juris" "$pid"
done < <(ps -axo pid=,command= | sed -nE 's|^ *([0-9]+) .*/os-update ([a-z]{2,3}) --scrape.*|\1 \2|p')

if [ "$found_any" = "0" ]; then
    echo "No active scrapers or archivers."
    echo
    echo "Most recent completions:"
    grep -E '^\[[0-9-]+ [0-9:]+\] (Scrape done|Archiving done|No new bills)' "$LOG" | tail -5 | sed 's/^/  /'
fi
