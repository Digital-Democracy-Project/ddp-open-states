#!/bin/bash
# os-status — status of active OpenStates scrapers and bill archivers.
#
# Invoked as `os status` (see the os() function in ~/.zshrc). Read-only:
# inspects ps, logs/scraper.log in the production checkout, file mtimes on
# DDP-HOT, and (for the archiver backlog specifically) a direct Postgres
# count. Estimates are rough by design and labeled as such:
#   - archiver backlog is a real count from Postgres (see db_backlog()) of
#     ddp_bill_version_document rows never created + rows with is_error=true
#     for the jurisdiction, not a guess from log text. Falls back to the old
#     last-summary-line heuristic if the DB is unreachable.
#   - throughput comes from files created on DDP-HOT in the last 15 minutes
#   - scraper ETA is just "how long the previous completed run took"
#
# Found 2026-08-09 (OPEN-55): the old log-derived "est. remaining" estimate
# used the *previous* run's own fetched+fetch_errors total as a stand-in for
# "backlog," which is really just "how much volume last run processed" — it
# has nothing to do with how much unprocessed work actually exists. A fresh
# MI archiver run showed "~6688 docs to upload" moments after starting, which
# read like a huge pending-upload queue; the real Postgres count told a
# different (and more useful) story: only 2 documents were actually
# S3-unverified, but 7,291 had is_error=true (almost entirely MI's
# application/pdf extractor gap, OPEN-49) plus 275 links never even attempted.
# That's the number worth seeing at a glance — a real backlog, not a rate
# projection.

LOG=/Users/agentsmith/Developer/repos/ddp-open-states/logs/scraper.log
RAW=/Volumes/DDP-HOT/Bills/raw
DB_CONTAINER=ddp-openstates-postgres-1
DB_USER=openstates
DB_NAME=openstates
DDP_SYNC_SCHEDULE_URL="http://localhost:8001/ddp-sync/v1/schedule"

# Full name for a jurisdiction abbr, for display only. Looked up from Postgres
# (opencivicdata_jurisdiction.name is the real source of truth DDP already
# maintains for every tracked jurisdiction) rather than a hardcoded list here
# that would silently go stale the next time a jurisdiction is added --
# exactly the class of bug just found and fixed in ddp-sync's own archive
# trigger endpoint (2026-08-10). Falls back to the abbr itself, uppercased, if
# the DB is unreachable or the abbr isn't a real jurisdiction.
juris_name() {
    local juris=$1 jid name
    if [ "$juris" = "us" ]; then
        jid="ocd-jurisdiction/country:us/government"
    else
        jid="ocd-jurisdiction/country:us/state:${juris}/government"
    fi
    name=$(docker exec "$DB_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -t -A -c \
        "SELECT name FROM opencivicdata_jurisdiction WHERE id = '$jid';" 2>/dev/null)
    if [ -n "$name" ]; then
        echo "$name"
    else
        echo "$juris" | tr '[:lower:]' '[:upper:]'
    fi
}

# Real backlog for $1=jurisdiction abbr (mi, wa, va, us, ...), straight from
# Postgres: version links with no ddp_bill_version_document row at all
# (never attempted) + document rows with is_error=true (attempted, failed).
# Prints "never_attempted|errored" on success, nothing on any failure (DB
# down, container not running, query error) so callers can fall back cleanly.
#
# No timeout wrapper: neither `timeout` nor `gtimeout` is installed on this
# machine (no GNU coreutils), and both `docker exec` against a stopped/missing
# container and `psql` against a refused connection already fail fast and
# cleanly on their own (verified directly, 2026-08-09) — an artificial
# timeout isn't needed for the realistic failure modes here.
db_backlog() {
    local juris=$1 jid
    if [ "$juris" = "us" ]; then
        jid="ocd-jurisdiction/country:us/government"
    else
        jid="ocd-jurisdiction/country:us/state:${juris}/government"
    fi
    docker exec "$DB_CONTAINER" psql -U "$DB_USER" -d "$DB_NAME" -t -A -F'|' -c "
        SELECT
          (SELECT count(*) FROM opencivicdata_billversionlink l
             JOIN opencivicdata_billversion v ON v.id = l.version_id
             JOIN opencivicdata_bill b ON b.id = v.bill_id
             JOIN opencivicdata_legislativesession ls ON ls.id = b.legislative_session_id
             WHERE ls.jurisdiction_id = '$jid') -
          (SELECT count(*) FROM ddp_bill_version_document d
             JOIN opencivicdata_bill b ON b.id = d.bill_id
             JOIN opencivicdata_legislativesession ls ON ls.id = b.legislative_session_id
             WHERE ls.jurisdiction_id = '$jid') AS never_attempted,
          (SELECT count(*) FROM ddp_bill_version_document d
             JOIN opencivicdata_bill b ON b.id = d.bill_id
             JOIN opencivicdata_legislativesession ls ON ls.id = b.legislative_session_id
             WHERE ls.jurisdiction_id = '$jid' AND d.is_error) AS errored;
    " 2>/dev/null
}

now_human=$(date '+%Y-%m-%d %H:%M:%S %Z')
found_any=0

humanize_min() {  # minutes -> "Xh Ym" / "Ym"
    local m=$1
    if [ "$m" -ge 60 ]; then echo "$((m / 60))h $((m % 60))m"; else echo "${m}m"; fi
}

# Timestamp ("YYYY-MM-DD HH:MM:SS") of the last log line matching $1.
last_log_ts() {
    grep -E "^\[[0-9-]+ [0-9:]+\] $1" "$LOG" | tail -1 | sed -E 's/^\[([0-9-]+ [0-9:]+)\].*/\1/'
}

# Duration (minutes) of the last COMPLETED run for a jurisdiction, from the
# wrapper's own bracketed log lines. $1=start-pattern $2=end-pattern
# (BSD awk has no mktime, so pair the lines by line number and diff with date.)
prev_run_minutes() {
    local end_line end_ln start_line s e se ee
    end_line=$(grep -nE "^\[[0-9-]+ [0-9:]+\] $2" "$LOG" | tail -1)
    [ -z "$end_line" ] && return
    end_ln=${end_line%%:*}
    start_line=$(head -n "$end_ln" "$LOG" | grep -nE "^\[[0-9-]+ [0-9:]+\] $1" | tail -1)
    [ -z "$start_line" ] && return
    s=$(echo "$start_line" | sed -E 's/^[0-9]+:\[([0-9-]+ [0-9:]+)\].*/\1/')
    e=$(echo "$end_line" | sed -E 's/^[0-9]+:\[([0-9-]+ [0-9:]+)\].*/\1/')
    se=$(date -j -f '%Y-%m-%d %H:%M:%S' "$s" +%s 2>/dev/null)
    ee=$(date -j -f '%Y-%m-%d %H:%M:%S' "$e" +%s 2>/dev/null)
    [ -n "$se" ] && [ -n "$ee" ] && echo $(((ee - se) / 60))
}

print_job() {  # $1=kind $2=jurisdiction $3=pid
    local kind=$1 juris=$2 pid=$3
    found_any=1
    local etime lstart start_fmt ppid orphan="" label name
    etime=$(ps -o etime= -p "$pid" | tr -d ' ')
    lstart=$(ps -o lstart= -p "$pid")
    ppid=$(ps -o ppid= -p "$pid" | tr -d ' ')
    [ "$ppid" = "1" ] && orphan="  (ORPHANED — parent gone; completion will not be logged/alerted)"
    start_fmt=$(date -j -f "%a %b %e %T %Y" "$lstart" '+%Y-%m-%d %H:%M:%S' 2>/dev/null)
    name=$(juris_name "$juris")
    if [ "$kind" = "ARCHIVER" ]; then
        label="Bill-document archiver"
    else
        label="Bill scraper"
    fi

    printf '%s — %s (%s), pid %s: running %s (started %s)%s\n' \
        "$label" "$name" "$juris" "$pid" "$etime" "${start_fmt:-?}" "$orphan"

    if [ "$kind" = "ARCHIVER" ] && [ -d "$RAW/$juris" ] && [ -n "$start_fmt" ]; then
        local done rate15 cutoff rate_disp="stalled?"
        done=$(find "$RAW/$juris" -type f ! -name '.DS_Store' -newermt "$start_fmt" 2>/dev/null | wc -l | tr -d ' ')
        cutoff=$(date -v-15M '+%Y-%m-%d %H:%M:%S')
        rate15=$(find "$RAW/$juris" -type f ! -name '.DS_Store' -newermt "$cutoff" 2>/dev/null | wc -l | tr -d ' ')
        [ "$rate15" -gt 0 ] && rate_disp="~$((rate15 / 15)).$(((rate15 * 10 / 15) % 10))/min"
        printf '  archived this run: %s docs on DDP-HOT (last 15m: %s)\n' "$done" "$rate_disp"

        # Real backlog: bills we've scraped (version links exist) that we haven't
        # successfully archived yet (no document row at all, or a document row
        # that errored) — a direct Postgres count, not a guess from log text.
        local db_result never_attempted errored not_archived
        db_result=$(db_backlog "$juris")
        if [ -n "$db_result" ]; then
            never_attempted=$(echo "$db_result" | cut -d'|' -f1)
            errored=$(echo "$db_result" | cut -d'|' -f2)
            not_archived=$((never_attempted + errored))
            if [ "$rate15" -gt 0 ] && [ "$not_archived" -gt 0 ]; then
                printf '  not yet archived:   %s docs (%s never attempted + %s failed) → ~%s at current rate\n' \
                    "$not_archived" "$never_attempted" "$errored" "$(humanize_min $((not_archived * 15 / rate15)))"
            else
                printf '  not yet archived:   %s docs (%s never attempted + %s failed)\n' \
                    "$not_archived" "$never_attempted" "$errored"
            fi
        else
            # DB unreachable (container down, timeout, etc.) — fall back to the
            # old rough estimate rather than showing nothing.
            local summary fetched errors backlog remaining summary_ts done_since
            summary=$(grep -E "^$juris: [0-9]+ bills checked" "$LOG" | tail -1)
            if [ -n "$summary" ]; then
                fetched=$(echo "$summary" | sed -E 's/.*fetched=([0-9]+).*/\1/')
                errors=$(echo "$summary" | sed -E 's/.*fetch_errors=([0-9]+).*/\1/')
                backlog=$((fetched + errors))
                summary_ts=$(last_log_ts "Archiving done: $juris")
                done_since=$done
                [ -n "$summary_ts" ] && done_since=$(find "$RAW/$juris" -type f ! -name '.DS_Store' -newermt "$summary_ts" 2>/dev/null | wc -l | tr -d ' ')
                remaining=$((backlog - done_since)); [ "$remaining" -lt 0 ] && remaining=0
                printf '  est. remaining:    ≤%s docs (rough; backlog from last summary — DB unreachable for a real count)\n' \
                    "$remaining"
            fi
        fi
        local prev
        prev=$(prev_run_minutes "Archiving bill documents: $juris" "Archiving done: $juris")
        [ -n "$prev" ] && printf '  previous run took: %s\n' "$(humanize_min "$prev")"
    fi

    if [ "$kind" = "SCRAPER" ]; then
        local last_summary prev
        last_summary=$(grep -E "=== SCRAPE SUMMARY: $juris " "$LOG" | tail -1 | sed -E 's/.*=== SCRAPE SUMMARY: //; s/ ===$//')
        [ -n "$last_summary" ] && printf '  last completed:    %s\n' "$last_summary"
        prev=$(prev_run_minutes "Scraping $juris" "Scrape done: $juris")
        [ -n "$prev" ] && printf '  previous run took: %s (rough ETA reference)\n' "$(humanize_min "$prev")"
    fi
    echo
}

echo "OpenStates jobs — $now_human"
echo

# Workers, not wrappers: os-update <state> --scrape (scraper),
# os-text-extract archive <abbr> (archiver).
while read -r pid juris; do
    print_job ARCHIVER "$juris" "$pid"
done < <(ps -axo pid=,command= | sed -nE 's|^ *([0-9]+) .*/os-text-extract archive ([a-z]{2,3}).*|\1 \2|p')

while read -r pid juris; do
    print_job SCRAPER "$juris" "$pid"
done < <(ps -axo pid=,command= | sed -nE 's|^ *([0-9]+) .*/os-update ([a-z]{2,3}) --scrape.*|\1 \2|p')

if [ "$found_any" = "0" ]; then
    echo "No active scrapers or archivers."
    echo
    echo "Most recent completions:"
    grep -E '^\[[0-9-]+ [0-9:]+\] (Scrape done|Archiving done|No new bills)' "$LOG" | tail -5 | sed 's/^/  /'
    echo
fi

# Scope note: this script only sees `os-update --scrape` / `os-text-extract archive`
# as real OS processes via `ps`. ddp-sync runs a bunch of OTHER OpenStates-adjacent
# jobs (bill_sync, legislator_sync, legislator_bio_sync, people_refresh,
# patch_refresh, concept_statement_dispatch, ...) as quick in-process function calls
# inside its own long-running daemon -- they never show up here even while running,
# and most matter more for *when they'll next fire* than whether they're active right
# now. Pull the full scheduled-job roster (all ~29 jobs, every jurisdiction's next
# archive day included) straight from ddp-sync's own live API instead of guessing.
schedule_json=$(curl -s --max-time 3 "$DDP_SYNC_SCHEDULE_URL" 2>/dev/null)
if [ -n "$schedule_json" ] && command -v python3 >/dev/null 2>&1; then
    echo "Full OpenStates-related job roster (ddp-sync, not just scraper/archiver):"
    echo "$schedule_json" | python3 -c '
import json, sys
try:
    data = json.load(sys.stdin)
except Exception:
    sys.exit(0)
jobs = data.get("jobs", [])
openstates_jobs = [j for j in jobs if "openstates" in j.get("id", "").lower()]
for j in sorted(openstates_jobs, key=lambda j: j.get("next_run") or ""):
    print("  {:<42} next: {}".format(j["name"], j["next_run"]))
' 2>/dev/null
    echo
    echo "(full 29-job roster incl. non-OpenStates jobs: $DDP_SYNC_SCHEDULE_URL)"
else
    echo "ddp-sync's /schedule API wasn't reachable ($DDP_SYNC_SCHEDULE_URL) -- can't show" \
         "the full job roster (bill sync, legislator sync, patch refresh, etc.), only what" \
         "this script can see directly as OS processes above."
fi
